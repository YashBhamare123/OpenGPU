#!/usr/bin/env bash
set -Eeuo pipefail

workspace_root=/var/lib/docker/opengpu-workspaces
xfs_mount=/var/lib/docker
project_base=200000

if [[ $# -ne 2 || ! "$1" =~ ^[1-9][0-9]*$ || ! "$2" =~ ^[1-9][0-9]*$ || "$2" -gt 199 ]]; then
  echo "Usage: opengpu-storage-init POSITIVE_USER_ID WORKSPACE_GB_1_TO_199" >&2
  exit 2
fi

user_id=$1
workspace_gb=$2
project_id=$((project_base + user_id))
user_root="$workspace_root/users/$user_id"
workspace="$user_root/workspace"
host_keys="$user_root/ssh-host-keys"

if [[ "$(findmnt -n -o FSTYPE -T "$xfs_mount")" != xfs ]]; then
  echo "$xfs_mount is not backed by XFS" >&2
  exit 1
fi
if ! findmnt -n -o OPTIONS -T "$xfs_mount" | grep -Eq '(^|,)(pquota|prjquota)(,|$)'; then
  echo "$xfs_mount is not mounted with project quotas" >&2
  exit 1
fi

install -d -m 0750 -o root -g root "$workspace_root" "$workspace_root/users" "$user_root"
install -d -m 0750 -o root -g root "$workspace"
install -d -m 0700 -o root -g root "$host_keys"

chattr -p "$project_id" +P "$workspace"
xfs_quota -x -c "limit -p bsoft=${workspace_gb}g bhard=${workspace_gb}g $project_id" "$xfs_mount"

printf 'user_id=%s project_id=%s workspace=%s workspace_gb=%s\n' "$user_id" "$project_id" "$workspace" "$workspace_gb"
