#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $EUID -ne 0 || -z "${SUDO_USER:-}" ]]; then
  echo "Run this installer with sudo from the scheduler account." >&2
  exit 2
fi

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
helper=/usr/local/sbin/opengpu-storage-init
sudoers_file=/etc/sudoers.d/opengpu-storage
source_helper="$project_dir/scripts/opengpu-storage-init"

workspace_root="${WORKSPACE_ROOT:-}"
if [[ -z "$workspace_root" && -f "$project_dir/.env" ]]; then
  workspace_root=$(sed -n 's/^WORKSPACE_ROOT=//p' "$project_dir/.env" | tail -n 1 | tr -d '[:space:]' | tr -d '"' | tr -d "'")
fi
if [[ -z "$workspace_root" ]]; then
  workspace_root=$(
    cd -- "$project_dir"
    python3 -c 'from config import settings; print(settings.workspace_root)'
  )
fi
if [[ "$workspace_root" != /* ]]; then
  echo "WORKSPACE_ROOT must be an absolute path: $workspace_root" >&2
  exit 2
fi

tmp_helper=$(mktemp)
trap 'rm -f "$tmp_helper"' EXIT
python3 - "$source_helper" "$tmp_helper" "$workspace_root" <<'PY'
import pathlib
import json
import sys

source, destination, root = sys.argv[1], sys.argv[2], sys.argv[3]
text = pathlib.Path(source).read_text()
token = 'workspace_root="__OPENGPU_WORKSPACE_ROOT__"'
if token not in text:
    raise SystemExit("storage helper is missing the WORKSPACE_ROOT placeholder")
pathlib.Path(destination).write_text(text.replace(token, "workspace_root=" + json.dumps(root), 1))
PY
install -m 0755 -o root -g root "$tmp_helper" "$helper"

printf '%s ALL=(root) NOPASSWD: %s prepare [0-9]* [0-9]* [0-9]*, %s teardown-scratch [0-9]*\n' \
  "$SUDO_USER" "$helper" "$helper" > "$sudoers_file"
chmod 0440 "$sudoers_file"
visudo -cf "$sudoers_file"

echo "Installed $helper with WORKSPACE_ROOT=$workspace_root and restricted sudo permission for $SUDO_USER."
