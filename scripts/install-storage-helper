#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $EUID -ne 0 || -z "${SUDO_USER:-}" ]]; then
  echo "Run this installer with sudo from the scheduler account." >&2
  exit 2
fi

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
helper=/usr/local/sbin/opengpu-storage-init
sudoers_file=/etc/sudoers.d/opengpu-storage

install -m 0755 -o root -g root "$project_dir/scripts/opengpu-storage-init" "$helper"
printf '%s ALL=(root) NOPASSWD: %s [0-9]* [0-9]*\n' "$SUDO_USER" "$helper" > "$sudoers_file"
chmod 0440 "$sudoers_file"
visudo -cf "$sudoers_file"

echo "Installed $helper and restricted sudo permission for $SUDO_USER."
