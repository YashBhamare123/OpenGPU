DATABASE_URL=postgresql://gpu_app:change-me@127.0.0.1:5432/gpu_reservation
# Address advertised in SSH commands when no remote tunnel is running.
SERVER_IP=10.0.0.10
# Private host interface where Docker publishes each per-user SSH port.
DOCKER_BIND_IP=10.0.0.10
DOCKER_IMAGE=yashbhamare123/opengpu:ml
# One local SSH gateway port. Use `opengpu serve --tunnel` only when NGROK_AUTHTOKEN is set.
SSH_PUBLIC_PORT=2222
SSH_GATEWAY_BIND=127.0.0.1
# Sparse ext4 images are created as WORKSPACE_ROOT/users/<team-id>/{workspace.img,scratch.img}.
WORKSPACE_ROOT=/var/lib/docker/opengpu-workspaces
STORAGE_HELPER=/usr/local/sbin/opengpu-storage-init
SSH_PORT_START=22001
SSH_PORT_END=32000

# start.sh API listener. Keep localhost when using an HTTPS reverse proxy.
API_HOST=127.0.0.1
API_PORT=8000
# Optional explicit env file. If unset, the first existing of /etc/opengpu/env,
# /etc/aiml-gpu-reservation.env, ~/.config/opengpu/env, then this directory's .env is used.
# OPENGPU_ENV_FILE=/etc/opengpu/env

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

COOKIE_SECURE=true
ALLOWED_ORIGINS=https://gpu-reservations.internal.example.edu,https://thing-balloon-arrive-contributed.trycloudflare.com
ADMIN_EMAILS=mc240041040@iiti.ac.in
ACCESS_CONTACT_EMAIL=cynaptics@iiti.ac.in
PUBLIC_BASE_URL=https://gpu-reservations.internal.example.edu

# Optional remote SSH tunnel. Set with: opengpu setup --token <authtoken>
NGROK_AUTHTOKEN=
# Optional reserved ngrok TCP address.
NGROK_TCP_ADDR=
# Optional fixed HTTPS hostname for ./start.sh --tunnel (web UI only).
NGROK_DOMAIN=

SESSION_HOURS=12
OTP_MINUTES=10
OTP_MAX_ATTEMPTS=5
RESERVATION_LIMIT_MINUTES=120
POLL_INTERVAL=5

CONTAINER_MEMORY=32g
CONTAINER_CPUS=16
CONTAINER_PIDS=4096
CONTAINER_SHM=16g
