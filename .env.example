DATABASE_URL=postgresql://gpu_app:change-me@127.0.0.1:5432/gpu_reservation
# Address advertised in SSH commands sent to users.
SERVER_IP=10.0.0.10
# Private host interface where Docker publishes each SSH port.
DOCKER_BIND_IP=10.0.0.10
DOCKER_IMAGE=opengpu:ml
# Host directories are created as WORKSPACE_ROOT/users/<team-id>/{workspace,ssh-host-keys}.
WORKSPACE_ROOT=/home/user/devbox-workspaces
SSH_PORT_START=22001
SSH_PORT_END=32000

# start.sh API listener. Keep localhost when using an HTTPS reverse proxy.
API_HOST=127.0.0.1
API_PORT=8000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

COOKIE_SECURE=true
ALLOWED_ORIGINS=https://gpu-reservations.internal.example.edu

# Optional fixed hostname assigned by an ngrok account. Use with ./start.sh --tunnel.
NGROK_DOMAIN=

SESSION_HOURS=12
OTP_MINUTES=10
OTP_MAX_ATTEMPTS=5
POLL_INTERVAL=5

CONTAINER_MEMORY=32g
CONTAINER_CPUS=16
CONTAINER_PIDS=4096
CONTAINER_SHM=16g
